+package net.openid.conformance.vci10wallet;
+
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+
+public class WalletSdJwtAlias_UnitTest {
+	@Test
+	public void aliasKeepsCredentialAndProofRequirements() {
+		var credentials = VCICredentialConfigurations.getDefault("alias-test");
+		var original = credentials.getAsJsonObject("eu.europa.ec.eudi.pid.1");
+		var alias = credentials.getAsJsonObject("wallet-test-sdjwt");
+		assertNotNull(alias);
+		var expected = original.deepCopy();
+		expected.addProperty("scope", "wallet-test-sdjwt");
+		assertEquals(expected, alias);
+	}
+}
